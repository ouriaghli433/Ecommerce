APP_NAME=Ecommerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. Inside Docker the host is the service name "database".
# Tests use their own database (ecommerce_test), set in phpunit.xml.
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=ecommerce

# This is a token API (Sanctum), so no server sessions are needed.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Jobs (notifications, order expiration) are stored in the jobs table.
# Run a worker: php artisan queue:work
QUEUE_CONNECTION=database

# Catalog listings are cached in Redis.
CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payments. "fake" is the local provider in app/Services/Payment.
PAYMENT_PROVIDER=fake
# Used to sign and check webhooks. Use a long random value outside local.
PAYMENT_WEBHOOK_SECRET=local-webhook-secret

# Shop rules. All amounts are integers in centimes (100 = 1.00 MAD).
SHOP_PAYMENT_WINDOW_MINUTES=20
SHOP_EXPIRATION_GRACE_MINUTES=2
SHOP_SHIPPING_AMOUNT=3000
SHOP_FREE_SHIPPING_FROM=50000
SHOP_TAX_PERCENT=0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
